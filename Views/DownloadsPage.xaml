<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TorrentApp.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TorrentApp.Views"
    xmlns:vm="using:TorrentApp.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================
             Header row: title + action buttons
        ============================================================ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="Downloads"
                Style="{StaticResource TitleTextBlockStyle}"
                VerticalAlignment="Center" />

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">

                <!-- Add Torrent File -->
                <Button
                    x:Name="AddFileButton"
                    Click="AddFileButton_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Add a .torrent file">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Add Torrent" />
                    </StackPanel>
                </Button>

                <!-- Add Magnet Link -->
                <Button
                    x:Name="AddMagnetButton"
                    Click="AddMagnetButton_Click"
                    ToolTipService.ToolTip="Paste a magnet link">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE71B;" FontSize="14" />
                        <TextBlock Text="Magnet Link" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============================================================
             Content: empty state OR torrent list
        ============================================================ -->
        <Grid Grid.Row="1">

            <!-- Empty state -->
            <StackPanel
                Style="{StaticResource EmptyStateStyle}"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <FontIcon
                    Glyph="&#xE896;"
                    FontSize="64"
                    Opacity="0.25"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="No downloads yet"
                    Style="{StaticResource TitleTextBlockStyle}"
                    HorizontalAlignment="Center"
                    Opacity="0.5" />
                <TextBlock
                    Text="Add a .torrent file or paste a magnet link to get started."
                    Style="{StaticResource BodyTextBlockStyle}"
                    HorizontalAlignment="Center"
                    Opacity="0.4"
                    TextAlignment="Center" />
                <Button
                    Content="+ Add Torrent"
                    Click="AddFileButton_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0" />
            </StackPanel>

            <!-- Torrent List -->
            <ListView
                x:Name="TorrentList"
                ItemsSource="{x:Bind ViewModel.Torrents, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedTorrent, Mode=TwoWay}"
                SelectionMode="Single"
                Visibility="{x:Bind ViewModel.IsNotEmpty, Mode=OneWay}"
                ScrollViewer.VerticalScrollBarVisibility="Auto">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,4,0,4" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TorrentItemViewModel">
                        <Border Style="{StaticResource TorrentCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Row 0: Name + Status + Action buttons -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <!-- Status icon -->
                                        <FontIcon
                                            x:Name="StatusIcon"
                                            FontSize="16"
                                            VerticalAlignment="Center"
                                            Glyph="&#xE896;"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                                        <TextBlock
                                            Text="{x:Bind Name, Mode=OneWay}"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            MaxWidth="400" />

                                        <!-- Status badge -->
                                        <Border
                                            Style="{StaticResource StatusBadgeStyle}"
                                            Background="{ThemeResource SubtleFillColorTertiaryBrush}">
                                            <TextBlock
                                                Text="{x:Bind StatusText, Mode=OneWay}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="4">

                                        <!-- Start/Resume button (visible when paused) -->
                                        <Button
                                            x:Name="StartButton"
                                            Tag="{x:Bind}"
                                            Click="StartButton_Click"
                                            Style="{StaticResource IconButtonStyle}"
                                            Visibility="{x:Bind CanStart, Mode=OneWay}"
                                            ToolTipService.ToolTip="Start / Resume">
                                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                                        </Button>

                                        <!-- Pause button (visible when downloading) -->
                                        <Button
                                            x:Name="PauseButton"
                                            Tag="{x:Bind}"
                                            Click="PauseButton_Click"
                                            Style="{StaticResource IconButtonStyle}"
                                            Visibility="{x:Bind CanPause, Mode=OneWay}"
                                            ToolTipService.ToolTip="Pause">
                                            <FontIcon Glyph="&#xE769;" FontSize="14" />
                                        </Button>

                                        <!-- More button -->
                                        <Button
                                            x:Name="MoreButton"
                                            Tag="{x:Bind}"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTipService.ToolTip="More options">
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem
                                                        Text="Open folder"
                                                        Tag="{x:Bind}"
                                                        Click="OpenFolderItem_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE838;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem
                                                        Text="Remove torrent"
                                                        Tag="{x:Bind}"
                                                        Click="RemoveItem_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE74D;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem
                                                        Text="Remove torrent + files"
                                                        Tag="{x:Bind}"
                                                        Click="RemoveWithFilesItem_Click"
                                                        Foreground="{StaticResource ErrorBrush}">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE74D;" Foreground="{StaticResource ErrorBrush}" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                            <FontIcon Glyph="&#xE712;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 2: Progress bar -->
                                <ProgressBar
                                    Grid.Row="2"
                                    Value="{x:Bind Progress, Mode=OneWay}"
                                    Style="{StaticResource TorrentProgressBarStyle}"
                                    Foreground="{StaticResource AccentBrush}" />

                                <!-- Row 4: Stats row -->
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Download speed -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE896;" FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            Text="{x:Bind DownloadSpeed, Mode=OneWay}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- Upload speed -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE898;" FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            Text="{x:Bind UploadSpeed, Mode=OneWay}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- Peers -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE902;" FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run Text="{x:Bind Peers, Mode=OneWay}" />
                                            <Run Text=" peers" />
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Progress % + ETA -->
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run Text="{x:Bind Downloaded, Mode=OneWay}" />
                                            <Run Text=" / " />
                                            <Run Text="{x:Bind TotalSize, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock
                                            Text="{x:Bind Eta, Mode=OneWay}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- ============================================================
             Status message bar (errors)
        ============================================================ -->
        <InfoBar
            Grid.Row="2"
            x:Name="StatusInfoBar"
            IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
            Severity="Error"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            IsClosable="True"
            Margin="0,8,0,0" />
    </Grid>
</Page>
