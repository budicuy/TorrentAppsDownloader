<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TorrentApp.Views.CompletedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="using:TorrentApp.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="Completed"
            Style="{StaticResource TitleTextBlockStyle}"
            Margin="0,0,0,16" />

        <ListView
            Grid.Row="1"
            ItemsSource="{x:Bind CompletedTorrents, Mode=OneWay}"
            SelectionMode="Single">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,4,0,4" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TorrentItemViewModel">
                    <Border Style="{StaticResource TorrentCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Grid.Column="0"
                                Glyph="&#xE930;"
                                FontSize="24"
                                Foreground="{StaticResource CompletedBrush}"
                                VerticalAlignment="Center" />

                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock
                                    Text="{x:Bind Name, Mode=OneWay}"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{x:Bind TotalSize, Mode=OneWay}" />
                                    <Run Text=" · Ratio: " />
                                </TextBlock>
                            </StackPanel>

                            <Button
                                Grid.Column="3"
                                Tag="{x:Bind}"
                                Click="OpenFolderButton_Click"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="Open folder">
                                <FontIcon Glyph="&#xE838;" FontSize="14" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>

            <!-- Empty state -->
            <ListView.Header>
                <StackPanel
                    Style="{StaticResource EmptyStateStyle}"
                    Visibility="{x:Bind IsEmpty, Mode=OneWay}"
                    Margin="0,60,0,0">
                    <FontIcon Glyph="&#xE930;" FontSize="48" Opacity="0.25" />
                    <TextBlock
                        Text="No completed downloads yet"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Opacity="0.5"
                        HorizontalAlignment="Center" />
                </StackPanel>
            </ListView.Header>
        </ListView>
    </Grid>
</Page>
