<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ====================================================
         Brushes — status colours inlined (WinUI 3: no <Color> resource element)
    ==================================================== -->

    <SolidColorBrush x:Key="AccentBrush"      Color="#0078D4" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#2899F5" />
    <SolidColorBrush x:Key="AccentDarkBrush"  Color="#005A9E" />

    <SolidColorBrush x:Key="DownloadingBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="PausedBrush"      Color="#8A8A8A" />
    <SolidColorBrush x:Key="CompletedBrush"   Color="#107C10" />
    <SolidColorBrush x:Key="ErrorBrush"       Color="#C42B1C" />
    <SolidColorBrush x:Key="FetchingBrush"    Color="#F7630C" />
    <SolidColorBrush x:Key="SeedingBrush"     Color="#00B294" />

    <!-- ====================================================
         Corner Radius
    ==================================================== -->
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ChipCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="ProgressCornerRadius">3</CornerRadius>

    <!-- ====================================================
         Spacing / Thickness tokens
    ==================================================== -->
    <x:Double   x:Key="ContentPadding">16</x:Double>
    <x:Double   x:Key="CardSpacing">8</x:Double>
    <x:Double   x:Key="SectionSpacing">24</x:Double>
    <Thickness  x:Key="CardPadding">16,12,16,12</Thickness>
    <Thickness  x:Key="PagePadding">20,16,20,16</Thickness>

    <!-- ====================================================
         Card Style (Border)
    ==================================================== -->
    <Style x:Key="TorrentCardStyle" TargetType="Border">
        <Setter Property="Background"       Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush"      Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness"  Value="1" />
        <Setter Property="CornerRadius"     Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding"          Value="{StaticResource CardPadding}" />
    </Style>

    <!-- ====================================================
         Progress Bar Style
    ==================================================== -->
    <Style x:Key="TorrentProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height"        Value="6" />
        <Setter Property="CornerRadius"  Value="{StaticResource ProgressCornerRadius}" />
        <Setter Property="Minimum"       Value="0" />
        <Setter Property="Maximum"       Value="1" />
    </Style>

    <!-- ====================================================
         Status Badge Style (Border chip)
    ==================================================== -->
    <Style x:Key="StatusBadgeStyle" TargetType="Border">
        <Setter Property="CornerRadius"      Value="{StaticResource ChipCornerRadius}" />
        <Setter Property="Padding"           Value="8,2,8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ====================================================
         Icon Button Style
    ==================================================== -->
    <Style x:Key="IconButtonStyle" TargetType="Button"
           BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width"   Value="36" />
        <Setter Property="Height"  Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource ButtonCornerRadius}" />
    </Style>

    <!-- ====================================================
         Section Header Style
    ==================================================== -->
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock"
           BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin"   Value="0,0,0,8" />
        <Setter Property="Opacity"  Value="0.7" />
    </Style>

    <!-- ====================================================
         Empty State Container Style
    ==================================================== -->
    <Style x:Key="EmptyStateStyle" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment"   Value="Center" />
        <Setter Property="Spacing"             Value="12" />
    </Style>

</ResourceDictionary>
